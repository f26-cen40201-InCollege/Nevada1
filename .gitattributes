# Description: Defining use of our '.gitattributes' file.
#       This defines attributes for Git/Github behavior, including:

        #1. - Scanning imported documents in this repository for HTML files and written code
        #2. - Ignoring the 'existence' of files using 'programming language(s)' undefined from the current project
        #3. - Ensuring no overlap of existing code files for seamless repository organization

 # Applying Necessary Programming Language Ignores for the current Repo
 # Current Repository: f26-cen40201-EventHub/nevada

 "Files This Repository Wants to detect:"
  *.cob linguist-detectable=true
  *.md linguist-detectable=true

 "Files This Repository is Restricting:"
  *.txt linguist-detectable=false
  *.pdf linguist-detectable=false
  *.png linguist-detectable=false
  *.sh linguist-detectable=false
  *.xml linguist-detectable=false
  *.json linguist-detectable=false
  *.yaml linguist-detectable=false